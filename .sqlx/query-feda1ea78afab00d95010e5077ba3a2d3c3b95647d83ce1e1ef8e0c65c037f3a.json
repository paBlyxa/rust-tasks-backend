  "query": "UPDATE tasks\n           SET title = COALESCE($1, title),\n               description = COALESCE($2, description),\n               completed = COALESCE($3, completed),\n               updated_at = NOW()\n           WHERE id = $4 AND user_id = $5\n           RETURNING id, title, description, user_id, completed, created_at, updated_at",
